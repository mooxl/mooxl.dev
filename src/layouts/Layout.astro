---
import "../styles/global.css";

const { lang = "de" } = Astro.props;
---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="initial-scale=1.0, width=device-width" />
		<title>Max Schmidt - Product Engineer</title>
		<meta name="description" content="Product Engineer and TypeScript enthusiast" />
		<link rel="icon" href="/favicon.ico" />
		<!-- hold the first paint until the whole page is parsed, so the grid never paints half-built -->
		<link rel="expect" href="#page-end" blocking="render" />
	</head>
	<body class="max-w-xl my-5 mx-auto max-lg:mx-2 max-sm:mx-1 max-md:my-3">
		<slot />
		<div id="page-end" hidden></div>
	</body>
</html>
