---
import { Image } from "astro:assets";
import me from "../../assets/me.jpg";
import Layout from "../../layouts/Layout.astro";
import de from "../../i18n/de.json";
import en from "../../i18n/en.json";

export const getStaticPaths = () => [
	{ params: { lang: undefined }, props: { lang: "en", t: en } },
	{ params: { lang: "de" }, props: { lang: "de", t: de } },
];

const { lang, t } = Astro.props;
const section = "text-md text-right uppercase max-lg:mt-6 max-lg:mb-2 max-md:mt-4 max-lg:text-left";
---

<Layout lang={lang}>
	<main class="grid grid-cols-[min-content_auto] gap-x-5 gap-y-10 max-lg:grid-cols-1 max-lg:gap-y-0">
		<div class="relative z-10 flex flex-col gap-2 items-end mt-[0.8rem] max-lg:flex-row max-lg:justify-start max-lg:mt-0 max-lg:mb-2 max-md:justify-end max-md:-mb-4 max-md:gap-1">
			<a
				href={lang === "en" ? "/de" : "/"}
				hreflang={lang === "en" ? "de" : "en"}
				aria-label={t.language}
				class="h-4 w-4 flex items-center justify-center text-[#898989] font-bold bg-gray-dark rounded-xl border-2 transition-colors border-transparent hover:border-gray-light"
			>
				{lang.toUpperCase()}
			</a>
		</div>

		<div class="flex justify-between gap-10 items-center max-md:flex-col max-md:gap-y-3 max-md:items-start">
			<div class="max-md:order-2">
				<hgroup>
					<h1>Max Schmidt</h1>
					<p class="my-1 text-lg font-bold leading-none max-sm:text-md">Product Engineer</p>
				</hgroup>
				<p class="whitespace-pre-wrap">{t.me.text}</p>
			</div>
			<Image
				class="rounded-full shrink-0 max-md:order-1 max-md:w-8"
				src={me}
				width={150}
				densities={[1, 2]}
				format="avif"
				loading="eager"
				alt="Max Schmidt"
			/>
		</div>

		<h2 class={section}>{t.experience.title}</h2>
		<div class="space-y-3 max-lg:space-y-2">
			{t.experience.jobs.map((job) => (
				<div class="flex justify-between max-md:flex-col">
					<div class="max-md:order-2">
						<h3>{job.name}</h3>
						{job.stations.map((station) => (
							<div class="mb-2">
								<h4>{station.role}</h4>
								<ul>
									{station.tasks.map((task) => <li>{task}</li>)}
								</ul>
							</div>
						))}
					</div>
					<p class="shrink-0 max-md:order-1 max-md:mb-[0.2rem]">{job.date}</p>
				</div>
			))}
		</div>

		<h2 class={section}>{t.education.title}</h2>
		<div class="space-y-3 max-lg:space-y-2">
			{t.education.milestones.map((milestone) => (
				<div>
					<div class="flex justify-between max-md:flex-col">
						<h3 class="max-md:order-2">{milestone.title}</h3>
						<p class="max-md:order-1 max-md:mb-[0.2rem]">{milestone.date}</p>
					</div>
					<p class="whitespace-pre-wrap">{milestone.text}</p>
				</div>
			))}
		</div>
	</main>
	<footer class="flex gap-1 items-start mt-20 max-lg:mt-10 justify-between">
		<a href="/imprint">{t.footer.imprint}</a>
		<a class="w-4" href="https://github.com/mooxl" rel="noreferrer noopener" target="_blank" aria-label="GitHub">
			<svg xmlns="http://www.w3.org/2000/svg" fill="white" class="w-full" aria-hidden="true" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
		</a>
		<a href="/privacy">{t.footer.privacy}</a>
	</footer>
</Layout>
